{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "VTuber AI Subtitle & Live Translator",
  "version": "1.0.0",
  "identifier": "com.vtuber.subtitle.translator",
  "build": {
    "frontendDist": "../dist/ui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:server",
    "beforeBuildCommand": "bun run build:server && bun run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VTuber Real-Time OBS AI Subtitle & Live Translator (TH / JP / EN)",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/vtuber-subtitle-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
